{
  "redirects": [
    { "source": "/feed.xml", "destination": "/blog.xml", "type": 301 },
    { "source": "/rss.xml", "destination": "/blog.xml", "type": 301 }
  ],
  "headers": [
    {
      "source": "/blog.xml",
      "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }]
    },
    {
      "source": "/planet-drupal.xml",
      "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
