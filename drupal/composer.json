{
    "name": "realityloop/foundry",
    "description": "Composer project template for the Drupal Foundry install profile using a relocated document root ",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/foundry",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.2",
        "cweagans/composer-patches": "^2.0.0",
        "drupal-tome/tome_drush": "dev-master",
        "drupal/admin_audit_trail": "^1.0",
        "drupal/admin_toolbar": "^3.6",
        "drupal/advanced_text_formatter": "4.0.x-dev",
        "drupal/allowed_formats": "^3.0",
        "drupal/anonymous_redirect": "^2.5",
        "drupal/coffee": "^2.0",
        "drupal/config_filter": "^2.7",
        "drupal/config_ignore": "^3.4",
        "drupal/config_pages": "^2.22",
        "drupal/content_lock": "^3.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/diff": "^2.1",
        "drupal/druxt": "^1.2.1",
        "drupal/dynamic_entity_reference": "4.x-dev",
        "drupal/entity_browser": "^2.15",
        "drupal/entity_browser_enhanced": "^2.0",
        "drupal/entity_clone": "2.x-dev",
        "drupal/entity_usage": "^2.2",
        "drupal/environment_indicator": "^4.0",
        "drupal/exclude_node_title": "^2.0",
        "drupal/field_group": "^4.0",
        "drupal/field_tools": "1.x-dev",
        "drupal/focal_point": "^2.1",
        "drupal/gin": "^5.0",
        "drupal/gin_login": "^2.1",
        "drupal/gin_toolbar": "^3.0",
        "drupal/jsonapi_hypermedia": "^1.10",
        "drupal/jsonapi_node_preview": "^1.0.0-beta4@beta",
        "drupal/jsonapi_node_preview_tab": "^1.0.2",
        "drupal/layout_paragraphs": "3.0.x-dev",
        "drupal/length_indicator": "^1.4",
        "drupal/linky": "2.x-dev",
        "drupal/linkychecker": "^2.2",
        "drupal/linkyreplacer": "^2.4",
        "drupal/m4032404": "^2.0",
        "drupal/masquerade": "^2.2",
        "drupal/maxlength": "^3.1",
        "drupal/media_file_delete": "^1.3",
        "drupal/memcache": "^2.8",
        "drupal/metatag": "^2.2",
        "drupal/node_edit_protection": "^1.2",
        "drupal/oembed_providers": "^3.0.0",
        "drupal/paragraphs_ee": "^10.1",
        "drupal/pathauto": "^1.15",
        "drupal/prevent_homepage_deletion": "^3.0",
        "drupal/redirect": "^1.13",
        "drupal/revision_log_default": "^1.4",
        "drupal/role_delegation": "^1.6",
        "drupal/scheduled_transitions": "^2.8",
        "drupal/schema_metatag": "^3.0",
        "drupal/security_review": "^3.1",
        "drupal/simple_oauth": "^6.1",
        "drupal/simple_sitemap": "^4.2",
        "drupal/tome": "^1.16",
        "drupal/username_enumeration_prevention": "^1.4",
        "drupal/viewfield": "3.x-dev"
    },
    "require-dev": {
        "drupal/core-dev": "^11",
        "drush/drush": "^13",
        "phpspec/prophecy-phpunit": "^2",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "mglaman/phpstan-drupal": "^1.2"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "php": "8.3",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "post-create-project-cmd": ""
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed Foundry  </>",
                "<bg=blue;fg=white>  from the realityloop/foundry template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps for an install in web/sites/default</>:",
                "  * Install the site via web UI by selecting `Use existing configuration' at install profile step",
                "  * Install the site via drush using 'drush si --existing-config' ",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "enable-patching": true,
        "patches": {
            "drupal/core": [
                {
                    "description": "EntityReferenceFieldItemNormalizer::constructValue() rejects any incoming target_type for dynamic_entity_reference fields (no fixed target_type setting to compare against), so Tome content import fails on any paragraph using a dynamic_entity_reference field (e.g. field_link on the card/link paragraph types)",
                    "url": "./patch/entity-reference-normalizer-dynamic-entity-reference-target-type.diff",
                    "depth": 1
                }
            ],
            "drupal/dynamic_entity_reference": {
                "https://www.drupal.org/project/dynamic_entity_reference/issues/3262121#comment-14396414": "./patch/3262121-by-realityloop-Rename-Label-to-Item-to.patch"
            },
            "drupal/focal_point": {
                "Missing AjaxHelperTrait use statement fatals FocalPointPreviewController on Drupal 11 (2.1.2 and dev-2.x both affected)": "./patch/3606059-focal-point-ajax-helper-trait-import.diff"
            },
            "drupal/gin_toolbar": {
                "https://www.drupal.org/project/gin_toolbar/issues/3217393": "./patch/3217393.diff"
            },
            "drupal/jsonapi_menu_items": {
                "getRouteResourceTypes() passes menu_link_content's null bundle_entity_type (it isn't bundled by a separate config entity) straight into hasDefinition(), a deprecated null-to-non-nullable-param call that's silently ignored in production but hard-fails under strict test error handling": "./patch/jsonapi-menu-items-null-bundle-entity-type-guard.diff"
            },
            "drupal/node_edit_protection": {
                "Triggers if button used instead of input https://www.drupal.org/project/node_edit_protection/issues/3208719": "./patch/3208719.diff"
            },
            "drupal/paragraphs": {
                "Paragraph::getAllBehaviorSettings() unserialize()s behavior_settings unconditionally, but the entity type's own serialized_field_property_names declaration means content denormalized via the generic serializer (Tome import) already provides it as a native array": "./patch/paragraphs-behavior-settings-array-guard.diff"
            },
            "drupal/tome": {
                "tome_sync's UriNormalizer crashes importing any map-typed field (e.g. layout_paragraphs' behavior_settings) on newer symfony/serializer, which now routes non-string field values through it": "./patch/tome-sync-urinormalizer-non-string-guard.diff"
            }
        }
    }
}
