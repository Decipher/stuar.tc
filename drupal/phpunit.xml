<?xml version="1.0" encoding="UTF-8"?>

<phpunit bootstrap="web/core/tests/bootstrap.php" colors="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutChangesToGlobalState="true"
         failOnWarning="true"
         printerClass="\Drupal\Tests\Listeners\HtmlOutputPrinter"
         cacheResult="false">
  <php>
    <ini name="error_reporting" value="32767"/>
    <ini name="memory_limit" value="-1"/>
    <!-- No Docker/DDEV — matches drupal/.devtools/ (PHP built-in server +
         SQLite). Both are overridable at invocation time (see Makefile's
         `test`/`test-functional` targets) since WEBSERVER_PORT can vary
         (auto-discovered); these are just sane defaults matching the
         Makefile's own default port. -->
    <!-- Two leading slashes after the host segment mean an absolute system
         path (see Drupal\sqlite\...\Connection::createConnectionOptionsFromUrl);
         placing per-test SQLite databases outside the repo tree avoids
         intermittent "disk I/O error"/"unable to open database file"
         failures on bind-mounted/virtiofs project directories, where SQLite's
         file-locking doesn't behave reliably under the write volume Drupal's
         own test bootstrap generates — the same workaround used by the
         field_tokens/imagefield_tokens/custom_formatters CI (SIMPLETEST_DB
         pointed at /tmp rather than a path under the repo). -->
    <env name="SIMPLETEST_BASE_URL" value="http://127.0.0.1:8888"/>
    <env name="SIMPLETEST_DB" value="sqlite://localhost//tmp/stuartclark-simpletest.sqlite"/>
    <env name="BROWSERTEST_OUTPUT_DIRECTORY" value=""/>
    <env name="BROWSERTEST_OUTPUT_BASE_URL" value=""/>
    <env name="MINK_DRIVER_CLASS" value=''/>
    <env name="MINK_DRIVER_ARGS" value=''/>
    <env name="MINK_DRIVER_ARGS_WEBDRIVER" value=''/>
  </php>
  <testsuites>
    <testsuite name="unit">
      <directory>web/modules/custom/*/tests/src/Unit</directory>
    </testsuite>
    <testsuite name="kernel">
      <directory>web/modules/custom/*/tests/src/Kernel</directory>
    </testsuite>
    <testsuite name="functional">
      <directory>web/modules/custom/*/tests/src/Functional</directory>
    </testsuite>
    <testsuite name="functional-javascript">
      <directory>web/modules/custom/*/tests/src/FunctionalJavascript</directory>
    </testsuite>
  </testsuites>
  <listeners>
    <listener class="\Drupal\Tests\Listeners\DrupalListener">
    </listener>
  </listeners>
</phpunit>
